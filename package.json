{
  "name": "memorai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "verify": "pnpm typecheck && pnpm lint && pnpm test",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "biome check . --max-diagnostics=20",
    "format": "biome format --write .",
    "test": "vitest run --reporter=dot",
    "test:e2e": "playwright test",
    "env:check": "node scripts/check-env.mjs",
    "db:indexes": "node --env-file-if-exists=.env.local scripts/db-indexes.mts",
    "db:ping": "node --env-file-if-exists=.env.local scripts/db-ping.mts",
    "demo": "next build && HOUSE_DEMO_MODE=true DEMO_HOUSE_TOKEN=demo-token next start",
    "autopilot": "node scripts/autopilot.mjs",
    "demo:check": "node --env-file-if-exists=.env.local scripts/demo-check.mts",
    "seed:demo": "node --conditions=react-server --env-file-if-exists=.env.local scripts/seed-demo.mts",
    "export:demo": "node --conditions=react-server --env-file-if-exists=.env.local scripts/export-demo.mts",
    "prepare": "husky",
    "scene:run": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/ts-resolve.mjs --conditions=react-server --env-file-if-exists=.env.local scripts/run-scene.mts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@fal-ai/client": "^1.10.1",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@hookform/resolvers": "^7.0.6",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toggle-group": "^1.2.1",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@tanstack/react-query": "^5.107.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "howler": "^2.2.4",
    "lucide-react": "^1.72.0",
    "mongodb": "^7.9.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.92.0",
    "server-only": "^0.0.1",
    "sharp": "0.35.5",
    "tailwind-merge": "^3.7.0",
    "three": "^0.187.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "^2.6.7",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/howler": "^2.2.13",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.187.0",
    "husky": "^9.1.7",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24"
  }
}
