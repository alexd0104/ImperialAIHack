# Copy to .env.local and fill in. Never commit .env.local. Never put secrets in NEXT_PUBLIC_*.

# --- AI ---
# mock = fixtures, no credits (default for dev, tests, CI). live = real fal/Claude calls.
AI_MODE=mock
MOCK_FAIL_RATE=0.1
FAL_KEY=
# Label used for budget accounting: dev-<name> for your key, "demo" for the demo key
FAL_KEY_LABEL=dev-yourname
FAL_BUDGET_USD=5
FAL_MAX_CONCURRENCY=2
ANTHROPIC_API_KEY=
CLAUDE_PROMPT_MODEL=claude-haiku-5-5
# Optional (SH6)
ELEVENLABS_API_KEY=

# --- Data ---
MONGODB_URI=
# Your own database: mh_timote | mh_alexandre | mh_yasir | mh_raphael | mh_demo
MONGODB_DB=mh_yourname
STORAGE_DIR=./storage
DEMO_ASSETS_DIR=./demo-assets
HOUSE_DEMO_MODE=false
DEMO_HOUSE_TOKEN=demo-token

# --- Studio access ---
STUDIO_PASSWORD=change-me
# 32+ random characters: openssl rand -base64 32
SESSION_SECRET=
GENERATION_RATE_LIMIT=10

# --- Claude Code hooks ---
# pipeline | studio | house | design
OWNER_ZONE=

# F7: ambience source ("text" or "clip") and creation-method lab
SOUND_MODE_DEFAULT=text
ENABLE_LAB=false
